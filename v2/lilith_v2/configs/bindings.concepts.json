{
  "bindings": [
    {"node_id": "branch.concepts", "modalities": ["text"], "stage": "concepts", "store_path": "./tmp/branch.concepts.json"},
    {"node_id": "trunk.vscode", "modalities": ["text"], "tenants": ["tenant_demo"]}
  ],
  "policy": {
    "timeout_ms": 300,
    "concurrency_limit": 2,
    "error_policy": {"retry": true, "backoff_ms": 100},
    "allow_endpoint_types": ["action", "retrieval"],
    "allow_modalities": ["text"],
    "deny": []
  },
  "pmflow": {
    "state_path": "./tmp/concepts_pmflow_state.sqlite",
    "event_path": "./tmp/concepts_pmflow_events.sqlite"
  }
}
